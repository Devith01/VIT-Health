PORT=5000
NODE_ENV=development

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vhealth_db?schema=public"

# Backend JWT configuration
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# Clerk authentication
CLERK_SECRET_KEY="your_clerk_secret_key_here"

# AI service
AI_SERVICE_URL="http://localhost:8000"

# CORS
CORS_ORIGIN="*"

# Frontend
FRONTEND_BASE_URL="http://localhost:5173"

# Emergency Notification System Configuration
TEST_EMERGENCY_NOTIFICATION=true
TEST_NOTIFICATION_RECIPIENT_PHONE="+919988776655"
TEST_NOTIFICATION_RECIPIENT_FCM="mock_fcm_device_token"

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
FCM_SERVER_KEY=""

