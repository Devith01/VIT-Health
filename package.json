{
  "name": "vhealth-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "V-Health AI-Powered Smart Campus Healthcare Monorepo Proposed for VTOP",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:ai": "cd ai-service && .\\venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000",
    "db:generate": "cd backend && npm run prisma:generate",
    "db:migrate": "cd backend && npm run prisma:migrate",
    "db:seed": "cd backend && npm run prisma:seed"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
